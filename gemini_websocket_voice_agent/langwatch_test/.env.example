# Google Gemini API Key (used for Judge and Adversarial Voice Agent)
GEMINI_API_KEY=your_gemini_api_key_here

# LangWatch API Key for Platform Analytics & Simulation Traces
LANGWATCH_API_KEY=your_langwatch_api_key_here

# Judge Model (evaluates conversation conduct, barge-in, politeness)
JUDGE_MODEL=gemini-3.1-flash-lite

# Adversarial Voice Agent Model (native audio generation)
ADVERSARIAL_MODEL=gemini-2.5-flash-native-audio-latest
ADVERSARIAL_VOICE=Puck

# Target Voice Agent WebSocket URL
WS_URL=ws://127.0.0.1:8765
