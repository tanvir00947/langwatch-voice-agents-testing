# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Native Audio model (real-time multimodal audio streaming)
GEMINI_MODEL=gemini-2.5-flash-native-audio-latest

# Voice personality (Options: Aoede, Algieba, Charon, Fenrir, Kore, Puck)
VOICE_NAME=Aoede

# WebSocket Server Configuration
WS_HOST=127.0.0.1
WS_PORT=8765
