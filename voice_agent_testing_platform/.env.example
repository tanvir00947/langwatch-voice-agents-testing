# ====================================================================
# Voice Agent & IVA/IVR Testing Platform - Environment Configuration
# ====================================================================

# 1. LLM API Keys (For LLM-as-a-Judge and Dynamic Caller Personas)
GEMINI_API_KEY=your_gemini_api_key_here
JUDGE_MODEL=gemini-2.5-flash
# Alternative Judge Provider (via LiteLLM): e.g. gpt-4o-mini, claude-3-5-sonnet-20241022
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 2. WebSocket Agent Defaults
DEFAULT_WS_URL=ws://127.0.0.1:8765

# 3. Telephony: Twilio Settings (Optional - for real Twilio calls)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+12025550143
DESTINATION_PHONE_NUMBER=+919876543210
TELEPHONY_MAX_DURATION_SECONDS=60
TELEPHONY_DRY_RUN=true

# 4. Telephony: Telnyx Settings (Optional - for real Telnyx calls)
TELNYX_API_KEY=KEYXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TELNYX_CONNECTION_ID=your_connection_id_here
TELNYX_PHONE_NUMBER=+12025550144

# 5. Web UI Dashboard Settings
WEB_UI_HOST=127.0.0.1
WEB_UI_PORT=8000

