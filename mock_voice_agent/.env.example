# =============================================================================
# Mock Voice Agent Environment Configuration
# Copy this file to .env and fill in your Gemini API key:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/macOS)
# =============================================================================

# Google Gemini API Key (Get a free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model to use (e.g. gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-3.1-flash-lite

# LangWatch API Key (Get from https://app.langwatch.ai -> Settings -> API Keys)
LANGWATCH_API_KEY=your_langwatch_api_key_here

# WebSocket Server Configuration
WS_HOST=127.0.0.1
WS_PORT=8765
