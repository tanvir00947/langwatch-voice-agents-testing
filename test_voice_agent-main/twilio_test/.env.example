# Copy this file to .env in this same folder, then replace every placeholder.
# Never commit your real .env file or share its credentials.

# Twilio Console > Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace_with_your_rotated_auth_token

# Twilio Console > Account > API keys & tokens
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=replace_with_your_api_key_secret

# Twilio Console > Voice > Manage > TwiML apps
# Set its Voice Request URL to https://YOUR-PUBLIC-HTTPS-TUNNEL/client-voice (POST).
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# E.164 international format, including the leading + and country code.
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
TO_PHONE_NUMBER=+91xxxxxxxxxx

# Public HTTPS tunnel forwarding to this laptop's port 8000.
# Configure the tunnel host below to reach http://127.0.0.1:8000.
PUBLIC_URL=https://your-public-tunnel.example

# Used only by the command-line launcher to reach the local Flask server.
LOCAL_SERVER_URL=http://127.0.0.1:8000

# Replace with a long, random value used to authorize starting/hanging up calls.
CALL_PIN=replace_with_a_long_random_private_pin
