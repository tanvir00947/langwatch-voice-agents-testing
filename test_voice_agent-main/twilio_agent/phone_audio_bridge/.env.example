# ==============================================================================
# Twilio Phone-to-Laptop Real-Time Audio Bridge Configuration
# Copy this file to .env and replace placeholder values with your credentials:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Twilio Credentials (Required for Live Calls)
# Find these in your Twilio Console dashboard: https://console.twilio.com/
# ------------------------------------------------------------------------------
# Account SID must begin with "AC"
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# ------------------------------------------------------------------------------
# 2. Phone Numbers (E.164 Format: +[country_code][number])
# ------------------------------------------------------------------------------
# Your purchased Twilio phone number with Voice capabilities
TWILIO_PHONE_NUMBER=+12025550143

# The personal phone number to dial (e.g. +91XXXXXXXXXX for India)
# NOTE FOR TRIAL ACCOUNTS: This number MUST be verified under:
# https://console.twilio.com/us1/develop/phone-numbers/manage/verified
# NOTE FOR INDIA (+91): Ensure Voice Geo Permissions are enabled:
# https://console.twilio.com/us1/develop/voice/settings/geo-permissions
TO_PHONE_NUMBER=+919876543210

# ------------------------------------------------------------------------------
# 3. Public Webhook / WebSocket Tunnel URL
# Twilio needs an HTTPS/WSS URL to reach your local server.
# ------------------------------------------------------------------------------
# Option A: Start your own ngrok tunnel (`ngrok http 8000`) and paste the URL:
PUBLIC_URL=https://your-subdomain.ngrok-free.app

# Option B: Set to 'auto' to let pyngrok establish the tunnel automatically:
# PUBLIC_URL=auto
# NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# ------------------------------------------------------------------------------
# 4. Server Binding Settings
# ------------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ------------------------------------------------------------------------------
# 5. Cost & Safety Safeguards
# ------------------------------------------------------------------------------
# Maximum call duration in seconds before automatic carrier hangup (default: 60)
MAX_CALL_DURATION_SECONDS=60

# Prompt for explicit "YES" confirmation in the terminal before dialing (default: true)
REQUIRE_CONFIRMATION=true

# Set to true to simulate server & audio flow without dialing or spending Twilio credits
DRY_RUN=false

